// use prisma-8

model User {
  id        ObjectId @id @map("_id")
  name      String?
  email     String   @unique
  password  String?
  role      String
  image     String?
  orders    Order[]
  reviews   Review[]
  createdAt Date
  updatedAt Date
  @@map("users")
}

model Category {
  id          ObjectId  @id @map("_id")
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   Date
  @@map("categories")
}

model Product {
  id          ObjectId    @id @map("_id")
  name        String
  slug        String      @unique
  description String
  subtitle    String?
  gender      String?
  sport       String?
  colorway    String?
  sku         String?
  badge       String?
  isNew       Bool?
  isBestseller Bool?
  price       Double
  salePrice   Double?
  stock       Int32
  images      String[]
  sizes       String[]
  colors      String[]
  isFeatured  Bool
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  ObjectId
  reviews     Review[]
  orderItems  OrderItem[]
  createdAt   Date
  updatedAt   Date
  @@map("products")
}

model Order {
  id              ObjectId    @id @map("_id")
  orderNumber     String      @unique
  user            User?       @relation(fields: [userId], references: [id])
  userId          ObjectId?
  customerEmail   String?
  customerName    String?
  customerPhone   String?
  items           OrderItem[]
  subtotal        Double?
  shippingFee     Double?
  discount        Double?
  couponCode      String?
  totalAmount     Double
  status          String
  paymentMethod   String
  paymentStatus   String
  trackingNumber  String?
  shippingAddress Json
  createdAt       Date
  updatedAt       Date
  @@map("orders")
}

model OrderItem {
  id        ObjectId @id @map("_id")
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId ObjectId
  name      String?
  image     String?
  quantity  Int32
  price     Double
  size      String?
  color     String?
  @@map("order_items")
}

model Review {
  id        ObjectId @id @map("_id")
  user      User     @relation(fields: [userId], references: [id])
  userId    ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId ObjectId
  rating    Int32
  title     String?
  comment   String?
  createdAt Date
  @@map("reviews")
}

model Coupon {
  id            ObjectId  @id @map("_id")
  code          String    @unique
  discountType  String
  discountValue Double
  minOrder      Double
  isActive      Bool
  createdAt     Date
  @@map("coupons")
}

